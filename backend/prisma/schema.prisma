// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// MODELOS F1 BASE - DATOS

model Driver {
  id            Int          @id @default(autoincrement())
  name          String
  acronym       String       @unique
  imageUrl      String?

  // Resultados
  results       Result[]

  // Asignaciones de temporada
  seasons SeasonDriver[]

  // Standings
  standings DriverEventStanding[]

  // Predicciones
  p1Predictions Prediction[] @relation("P1Driver")
  p2Predictions Prediction[] @relation("P2Driver")
  p3Predictions Prediction[] @relation("P3Driver")
}

model Team {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  nationality   String?
  factoryBase   String?

  // Asignaciones de temporada
  seasons  SeasonTeam[]

  // Resultados
  results  Result[]

  // Standings
  driverStandings   DriverEventStanding[]
  teamStandings     TeamEventStanding[]
}

model Country {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  name    String
  flagUrl String?

  // Circuitos del país
  circuits  Circuit[]
}

model Circuit {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  type      String?
  imageUrl  String?
  info      String?
  lengthKm  Float?
  corners   Int?

  // FK país
  countryId   Int
  country     Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)

  // Eventos de un circuito
  events   Event[]
}

model Event {
  id           Int          @id @default(autoincrement())
  name         String
  officialName String?
  startDate    DateTime
  endDate      DateTime
  isCancelled  Boolean      @default(false)
  laps         Int?

  // FK circuito
  circuitId    Int
  circuit      Circuit      @relation(fields: [circuitId], references: [id])

  // FK temporada
  seasonId    Int
  season      Season        @relation(fields: [seasonId], references: [year], onDelete: Restrict)

  // Sesiones de un evento (GP)
  sessions    Session[]

  // Standings
  driverStandings   DriverEventStanding[]
  teamStandings     TeamEventStanding[]

  // Predicciones
  predictions  Prediction[]

  @@unique([name, seasonId]) // <-- Clave compuesta única
}

model Season {
  year      Int        @id

  // Eventos de una temporada
  events    Event[]

  // Asignaciones de pilotos de una temporada
  drivers   SeasonDriver[]

  // Asignaciones de equipos de una temporada
  teams     SeasonTeam[]
}

model SeasonDriver {
  number   Int

  // FK temporada
  year     Int
  season   Season @relation(fields: [year], references: [year], onDelete: Restrict)

  // FK piloto
  driverId Int
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  // PK Compuesta
  @@id([driverId, year])

  // En revisión: NO APLICABLE por pilotos jóvenes de FP1...
  // @@unique([year, number]) // No se repiten dorsales en la misma temporada
}

model SeasonTeam {
  teamId    Int
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  year      Int
  season    Season  @relation(fields: [year], references: [year], onDelete: Cascade)

  // Datos dinámicos por temporada
  officialName  String?   // Ej: "Stake F1 Team Kick Sauber" (2024) vs "Audi F1 Team" (2026)
  colour        String?   // Ej: Hexadecimal del livery de ese año

  @@id([teamId, year])
}

model Session {
  id          Int     @id @default(autoincrement())
  type        String
  startDate   DateTime
  endDate     DateTime

  // FK evento (GP)
  eventId     Int
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Resultados
  results     Result[]

  // UNIQUE
  @@unique([eventId, type])
}

model Result {
  id            Int     @id @default(autoincrement())
  position      Int?    // Opcional para DNF/DNS/DSQ
  status        String
  gapToLeader   String?

  // Subtablas 1:1
  raceData      RaceResult?
  qualyData     QualyResult?
  practiceData  PracticeResult?

  // FK sesión
  sessionId     Int
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  // FK piloto
  driverId      Int
  driver        Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)

  // FK equipo
  teamId        Int
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)

  // UNIQUE
  @@unique([sessionId, driverId])
}

model RaceResult {
  resultId      Int       @id
  result        Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  gridPosition  Int?
  points        Float     @default(0)
  fastestLap    Boolean   @default(false)
}

model QualyResult {
  resultId    Int       @id
  result      Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  q1Time      Float?
  q2Time      Float?
  q3Time      Float?
}

model PracticeResult {
  resultId    Int       @id
  result      Result    @relation(fields: [resultId], references: [id], onDelete: Cascade)

  bestTime        Float?
  lapsCompleted   Int   @default(0)
}

// STANDINGS
model DriverEventStanding {
  position  Int    // Posición en el campeonato tras este evento
  points    Float  // Puntos acumulados hasta este evento

  driverId  Int
  driver    Driver @relation(fields: [driverId], references: [id])

  eventId   Int
  event     Event  @relation(fields: [eventId], references: [id])

  teamId    Int
  team      Team  @relation(fields: [teamId], references: [id])

  // PK compuesta: Un piloto solo tiene 1 registro de clasificación por GP
  @@id([driverId, eventId])
}

model TeamEventStanding {
  position  Int
  points    Float

  teamId    Int
  team      Team    @relation(fields: [teamId], references: [id])

  eventId   Int
  event     Event   @relation(fields: [eventId], references: [id])

  // PK compuesta: Un equipo solo tiene 1 registro de clasificación por GP
  @@id([teamId, eventId])
}



// MODELOS DE LA PARTE DE USUARIO

model User {
  id          Int          @id @default(autoincrement())
  username    String       @unique
  password    String
  createdAt   DateTime     @default(now())
  threads     Thread[]
  messages    Message[]
  likes       MessageLike[]
  predictions Prediction[]
}

model Thread {
  id        Int       @id @default(autoincrement())
  title     String
  authorId  Int
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        Int           @id @default(autoincrement())
  content   String
  threadId  Int
  thread    Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  Int
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  likes     MessageLike[]
}

model MessageLike {
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
}

model Prediction {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id])
  p1DriverId     Int
  p1Driver       Driver   @relation("P1Driver", fields: [p1DriverId], references: [id])
  p2DriverId     Int
  p2Driver       Driver   @relation("P2Driver", fields: [p2DriverId], references: [id])
  p3DriverId     Int
  p3Driver       Driver   @relation("P3Driver", fields: [p3DriverId], references: [id])
  pointsObtained Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([userId, eventId])
}

